		"src/index.ts"
	],
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.14",
		"@vitest/coverage-v8": "^4.0.18",
		"typedoc": "^0.28.16",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	}
}
