{
	"name": "@algorandfoundation/wallet-provider",
	"version": "1.0.0-canary.3",
	"description": "Abstract interface for compatibility between wallets",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"author": "Algorand Foundation",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/algorandfoundation/wallet-provider.git"
	},
	"scripts": {
		"build": "tsc",
		"lint": "biome check",
		"lint:fix": "biome check --fix",
		"docs": "typedoc",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"bench": "vitest bench",
		"release": "npx semantic-release"
	},
	"files": [
		"*.js",
		"*.js.map",
		"*.d.ts",
		"*.d.ts.map",
		"src/types.ts",
		"src/index.ts"
	],
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.14",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^12.0.5",
		"@semantic-release/npm": "^13.1.4",
		"@semantic-release/release-notes-generator": "^14.1.0",
		"@vitest/coverage-v8": "^4.0.18",
		"typedoc": "^0.28.16",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	},
	"release": {
		"plugins": [
			"@semantic-release/commit-analyzer",
			"@semantic-release/release-notes-generator",
			"@semantic-release/changelog",
			"@semantic-release/npm",
			[
				"@semantic-release/git",
				{
					"assets": [
						"CHANGELOG.md",
						"package.json"
					],
					"message": "chore(release): [skip ci] Wallet Provider \n\n${nextRelease.notes}"
				}
			],
			[
				"@semantic-release/github",
				{
					"successComment": false
				}
			]
		],
		"branches": [
			"release",
			{
				"name": "main",
				"prerelease": "canary"
			}
		]
	}
}
